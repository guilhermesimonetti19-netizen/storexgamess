# Copie para .env (local) e NUNCA envie o .env ao Git. Valores abaixo são FICTÍCIOS.
# Cloudflare Pages local/produção: use as mesmas variáveis no painel (Settings > Variables) ou .dev.vars.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). Vai ao navegador; NÃO substitui RLS.
SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON
# SECRETA. Somente servidor. Nunca no navegador/Git.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE

# --- Site ---
# URL pública do site (sem barra final). Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- InfinitePay (Checkout Integrado) ---
# Sua InfiniteTag SEM o "$". Vazio = modo de teste (pedido é criado, sem checkout real).
INFINITEPAY_HANDLE=
# Segredo próprio (gere um aleatório longo). É anexado à URL do webhook (?t=...).
# A InfinitePay NÃO oferece assinatura de webhook; a prova de pagamento é a consulta server-side a /payment_check.
WEBHOOK_SECRET=GERE_UM_VALOR_ALEATORIO_LONGO

# --- Regras operacionais (opcionais) ---
PENDING_EXPIRE_HOURS=48
